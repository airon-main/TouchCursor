<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.MouseAccessibilityService"
            android:exported="true"
            android:label="@string/service_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service" />
        </service>

        <service
            android:name=".service.PadTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_touchpad"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <receiver
            android:name=".input.ExternalTriggerReceiver"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="ru.vasys.keycursor.input.DOWN" />
                <action android:name="ru.vasys.keycursor.input.UP" />
                <action android:name="ru.vasys.keycursor.input.PULSE" />
                <action android:name="ru.vasys.keycursor.action.MOUSE_TOGGLE" />
                <action android:name="ru.vasys.keycursor.action.MODE_TOGGLE" />
                <action android:name="ru.vasys.keycursor.action.PAD_TOGGLE" />
                <action android:name="ru.vasys.keycursor.action.MOUSE_KEY_SHORT" />
                <action android:name="ru.vasys.keycursor.action.MOUSE_KEY_LONG" />
                <action android:name="ru.vasys.keycursor.action.MOUSE_KEY_DOWN" />
                <action android:name="ru.vasys.keycursor.action.MOUSE_KEY_UP" />
                <action android:name="ru.vasys.keycursor.action.CURSOR_NEXT" />
                <action android:name="ru.vasys.keycursor.action.LEFT_DOWN" />
                <action android:name="ru.vasys.keycursor.action.LEFT_UP" />
                <action android:name="ru.vasys.keycursor.action.MOVE_UP" />
                <action android:name="ru.vasys.keycursor.action.MOVE_UP_RIGHT" />
                <action android:name="ru.vasys.keycursor.action.MOVE_RIGHT" />
                <action android:name="ru.vasys.keycursor.action.MOVE_DOWN_RIGHT" />
                <action android:name="ru.vasys.keycursor.action.MOVE_DOWN" />
                <action android:name="ru.vasys.keycursor.action.MOVE_DOWN_LEFT" />
                <action android:name="ru.vasys.keycursor.action.MOVE_LEFT" />
                <action android:name="ru.vasys.keycursor.action.MOVE_UP_LEFT" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
